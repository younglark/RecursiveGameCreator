# Copy to .env.gamecraft in the repository root, then fill in your judge API key.
# Docker env-file syntax: KEY=value (no export, no surrounding quotes).
# No Codex authentication file is used by the benchmark judge.
GAMECRAFT_BENCH_JUDGE=openai
# This is the default model in the checked-out GameCraft verifier, not the generator.
GAMECRAFT_BENCH_JUDGE_MODEL=gpt-5.5
GAMECRAFT_BENCH_JUDGE_OPENAI_API_KEY=
# Optional, only when using your own OpenAI-compatible endpoint:
# GAMECRAFT_BENCH_JUDGE_OPENAI_BASE_URL=https://your-endpoint.example/v1
